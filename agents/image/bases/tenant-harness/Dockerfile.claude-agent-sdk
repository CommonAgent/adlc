# The Claude Agent SDK as a harness in the tenant sandbox, for a try of a
# plugin that declares Claude Code (docs/harness-contract.md in the AgentMesh
# repository). Built from the bases folder:
#
#   cd agents/image/bases
#   gcloud builds submit --config tenant-harness/cloudbuild.yaml --project <tenant project> .
#
# It is node, the SDK (pinned; npm checks the tarball against the registry's
# digest), the runner that meets the contract, harness-serve and the contract
# check. No key, no model and no address: the model door arrives as
# ANTHROPIC_BASE_URL from the adapter.
FROM node:22-bookworm-slim

ARG CLAUDE_AGENT_SDK_VERSION=0.3.323
WORKDIR /opt/harness
RUN npm init -y >/dev/null \
 && npm install @anthropic-ai/claude-agent-sdk@${CLAUDE_AGENT_SDK_VERSION} --no-audit --no-fund --loglevel=error

COPY tenant-harness/claude-agent-sdk-run.mjs /opt/harness/bin/claude-agent-sdk-run.mjs
COPY tenant-harness/harness-serve.mjs /opt/harness/bin/harness-serve.mjs
COPY tenant-harness/check /opt/harness/check
RUN mkdir -p /opt/agent/plugin
WORKDIR /

ENV AGENT_HARNESS=claude-agent-sdk \
    AGENT_HARNESS_BIN=/opt/harness/bin/claude-agent-sdk-run.mjs \
    AGENT_PACKAGE=/opt/agent/plugin \
    HARNESS_MODEL=house-stack \
    HARNESS_MAX_OUTPUT_TOKENS=16000 \
    HARNESS_PORT=8085

CMD ["node", "/opt/harness/bin/harness-serve.mjs"]
