# opencode as a harness in the tenant sandbox, for a try (docs/harness-contract.md
# in the AgentMesh repository). Built from the bases folder, so that it takes
# the opencode wrapper and its configuration from agentmesh-harness, the same
# two files the fleet's harness bases run:
#
#   cd agents/image/bases
#   gcloud builds submit --config tenant-harness/cloudbuild.yaml --project <tenant project> .
#
# It is node and opencode, the wrapper, harness-serve (the server a try's
# adapter hands each message to) and the contract check. No key, no model and
# no address: the model door arrives as ANTHROPIC_BASE_URL from the adapter.
# The deployment manager builds a try on it: the plugin's own files at
# Inspect's commit under /opt/agent/plugin, and the mcp.json the platform wrote.
FROM node:22-bookworm-slim

ARG OPENCODE_VERSION=1.18.30
RUN npm install -g opencode-ai@${OPENCODE_VERSION} --no-audit --no-fund --loglevel=error

COPY agentmesh-harness/harness /opt/harness/bin/harness
COPY agentmesh-harness/opencode-config.mjs /opt/harness/bin/opencode-config.mjs
COPY tenant-harness/harness-serve.mjs /opt/harness/bin/harness-serve.mjs
# The contract check and its fixture plugin (a test, so the address check leaves it out).
COPY tenant-harness/test /opt/harness/check
RUN chmod 0755 /opt/harness/bin/harness && mkdir -p /opt/agent/plugin

# The model door is a gateway provider to opencode (opencode-config.mjs
# gatewayProvider), its address the adapter's ANTHROPIC_BASE_URL (harness-serve
# names it MODEL_ENDPOINT). The model's name is the one the door is asked for;
# the door puts the House Stack model in. A 200,000-token context makes
# opencode compact before the door's cap. The OPENCODE_DISABLE_ flags keep it
# off the network: no update checks, no default plugins fetched from npm, no
# model catalogue, no language servers downloaded.
ENV AGENT_HARNESS=opencode \
    AGENT_HARNESS_BIN=/opt/harness/bin/harness \
    AGENT_PACKAGE=/opt/agent/plugin \
    AGENT_MODEL=model-gateway/house-stack \
    MODEL_PROTOCOL=anthropic-messages \
    MODEL_CONTEXT_TOKENS=200000 \
    MODEL_OUTPUT_TOKENS=16000 \
    HARNESS_READS_MCP_JSON=1 \
    HARNESS_PORT=8085 \
    OPENCODE_DISABLE_AUTOUPDATE=1 \
    OPENCODE_DISABLE_DEFAULT_PLUGINS=1 \
    OPENCODE_DISABLE_MODELS_FETCH=1 \
    OPENCODE_DISABLE_LSP_DOWNLOAD=1

CMD ["node", "/opt/harness/bin/harness-serve.mjs"]
