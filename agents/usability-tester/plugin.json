{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "usability-tester",
  "version": "0.2.0",
  "description": "Runs an agent the way a person would, from the examples it declares, and reports whether a person can fill its form, get a result, read it and get a change.",
  "license": "Apache-2.0",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "test-usability",
    "read-the-request",
    "check-the-descriptor",
    "run-the-examples",
    "ask-for-a-change",
    "write-the-report"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "test-usability": {
            "scripts": [
              "scripts/test-usability.mjs",
              "scripts/read-request.mjs",
              "scripts/descriptor-checks.mjs",
              "scripts/form.mjs",
              "scripts/platform.mjs",
              "scripts/retry.mjs",
              "scripts/trial.mjs",
              "scripts/readable.mjs",
              "scripts/report.mjs",
              "scripts/revision.mjs",
              "scripts/run-config.mjs",
              "scripts/pieces.mjs",
              "scripts/tar.mjs",
              "scripts/went-without.mjs"
            ],
            "references": [
              "references/what-a-person-meets.md",
              "rules.md"
            ]
          },
          "read-the-request": {
            "scripts": [
              "scripts/read-request.mjs",
              "scripts/platform.mjs",
              "scripts/retry.mjs",
              "scripts/tar.mjs"
            ]
          },
          "check-the-descriptor": {
            "scripts": [
              "scripts/descriptor-checks.mjs"
            ],
            "references": [
              "references/what-a-person-meets.md"
            ]
          },
          "run-the-examples": {
            "scripts": [
              "scripts/form.mjs",
              "scripts/trial.mjs",
              "scripts/readable.mjs",
              "scripts/platform.mjs",
              "scripts/retry.mjs",
              "scripts/descriptor-checks.mjs"
            ],
            "references": [
              "references/what-a-person-meets.md"
            ]
          },
          "ask-for-a-change": {
            "scripts": [
              "scripts/trial.mjs",
              "scripts/readable.mjs",
              "scripts/platform.mjs",
              "scripts/retry.mjs",
              "scripts/descriptor-checks.mjs"
            ]
          },
          "write-the-report": {
            "scripts": [
              "scripts/report.mjs",
              "scripts/pieces.mjs",
              "scripts/revision.mjs",
              "scripts/read-request.mjs",
              "scripts/tar.mjs",
              "scripts/went-without.mjs"
            ]
          }
        }
      }
    }
  }
}
