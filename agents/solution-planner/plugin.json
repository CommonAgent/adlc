{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "planner",
  "version": "0.3.2",
  "description": "Plans a described piece of work as steps, each saying what kind of work it is, what it takes and what it hands back. It names no agent for any step: the catalog answers each step at the next stage, Source, with an agent that already exists, a solution, or a new agent to build. The plan is checked in code before it is written, and it is handed back to whoever asked for it.",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "built-agent",
    "draft",
    "make-a-plan",
    "read-the-request",
    "ask-the-model",
    "check-the-plan",
    "write-the-plan"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "make-a-plan": {
            "scripts": [
              "scripts/plan.mjs",
              "scripts/request.mjs",
              "scripts/ask.mjs",
              "scripts/check.mjs",
              "scripts/went-without.mjs",
              "scripts/pieces.mjs"
            ]
          },
          "read-the-request": {
            "scripts": [
              "scripts/request.mjs"
            ]
          },
          "ask-the-model": {
            "scripts": [
              "scripts/ask.mjs"
            ]
          },
          "check-the-plan": {
            "scripts": [
              "scripts/check.mjs"
            ]
          },
          "write-the-plan": {
            "scripts": [
              "scripts/pieces.mjs",
              "scripts/went-without.mjs"
            ]
          }
        }
      }
    }
  }
}
