{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "planner",
  "version": "0.4.0",
  "description": "Plans a piece of work you describe as steps, each saying what kind of work it is, what it takes and what it hands back.",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "make-a-plan",
    "read-the-request",
    "ask-the-model",
    "check-the-plan",
    "write-the-plan"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "make-a-plan": {
            "scripts": [
              "scripts/plan.mjs",
              "scripts/request.mjs",
              "scripts/ask.mjs",
              "scripts/model-caller.mjs",
              "scripts/check.mjs",
              "scripts/went-without.mjs",
              "scripts/pieces.mjs"
            ]
          },
          "read-the-request": {
            "scripts": [
              "scripts/request.mjs"
            ]
          },
          "ask-the-model": {
            "scripts": [
              "scripts/ask.mjs",
              "scripts/model-caller.mjs"
            ]
          },
          "check-the-plan": {
            "scripts": [
              "scripts/check.mjs"
            ]
          },
          "write-the-plan": {
            "scripts": [
              "scripts/pieces.mjs",
              "scripts/went-without.mjs"
            ]
          }
        }
      }
    }
  }
}
