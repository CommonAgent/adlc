{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "watcher",
  "version": "0.1.5",
  "description": "Checks that the agents you name are alive, answering and inside their limits, and reports what each spent against what you allowed.",
  "license": "Apache-2.0",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "watch-the-fleet",
    "read-the-watch-list",
    "ask-each-agent",
    "check-the-limits",
    "read-the-spend",
    "write-the-report",
    "raise-the-alarms"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "watch-the-fleet": {
            "scripts": [
              "scripts/declines.mjs",
              "scripts/watch.mjs",
              "scripts/watch-list.mjs",
              "scripts/ask.mjs",
              "scripts/outbox.mjs",
              "scripts/rounds.mjs",
              "scripts/platform.mjs",
              "scripts/checks.mjs",
              "scripts/spend.mjs",
              "scripts/write-report.mjs",
              "scripts/alarms.mjs",
              "scripts/pieces.mjs",
              "scripts/went-without.mjs"
            ],
            "references": [
              "references/what-the-watcher-reads.md",
              "rules.md"
            ]
          },
          "read-the-watch-list": {
            "scripts": [
              "scripts/watch-list.mjs"
            ]
          },
          "ask-each-agent": {
            "scripts": [
              "scripts/ask.mjs",
              "scripts/outbox.mjs",
              "scripts/rounds.mjs"
            ],
            "references": [
              "references/what-the-watcher-reads.md"
            ]
          },
          "check-the-limits": {
            "scripts": [
              "scripts/checks.mjs",
              "scripts/platform.mjs",
              "scripts/ask.mjs",
              "scripts/outbox.mjs",
              "scripts/spend.mjs"
            ],
            "references": [
              "references/what-the-watcher-reads.md"
            ]
          },
          "read-the-spend": {
            "scripts": [
              "scripts/spend.mjs",
              "scripts/platform.mjs"
            ],
            "references": [
              "references/what-the-watcher-reads.md"
            ]
          },
          "write-the-report": {
            "scripts": [
              "scripts/write-report.mjs",
              "scripts/spend.mjs"
            ]
          },
          "raise-the-alarms": {
            "scripts": [
              "scripts/alarms.mjs",
              "scripts/outbox.mjs",
              "scripts/pieces.mjs",
              "scripts/went-without.mjs"
            ]
          }
        }
      }
    }
  }
}
