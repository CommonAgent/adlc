{
  "format": "agent-runtime-requirements-v1",
  "runtimes": [
    {
      "name": "node",
      "version": ">=22"
    }
  ],
  "binaries": [],
  "dependencies": [],
  "systems": [
    {
      "name": "text-reasoning",
      "kind": "model",
      "protocols": [
        "anthropic-messages"
      ]
    }
  ],
  "ceilings": [],
  "directories": [
    {
      "name": "records",
      "purpose": "the declaration, the suite, the check and the calls for each job"
    },
    {
      "name": "work",
      "purpose": "the suite files as written, before they are delivered"
    }
  ],
  "job_seconds": 900,
  "wants_replies": true,
  "price": {
    "sku": "default",
    "covers": {
      "offerings": [
        "write-a-suite",
        "prove-a-suite"
      ]
    },
    "price": {
      "model": "flat",
      "amount_micro": 500000,
      "currency": "USD"
    }
  },
  "run": {
    "write-a-suite": {
      "command": [
        "node",
        "{home}/{package}/skills/write-a-suite/scripts/job.mjs",
        "--job",
        "{job_dir}",
        "--records",
        "{records}",
        "--work",
        "{work}",
        "--text-file",
        "{job_dir}/message.txt"
      ],
      "reply": "json:reply",
      "per_file": [
        "--file",
        "{file_path}::{file_media_type}"
      ],
      "message_file": "{job_dir}/message.txt"
    }
  }
}
