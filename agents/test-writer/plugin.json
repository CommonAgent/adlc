{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "test-writer",
  "version": "0.11.0",
  "description": "Writes the tests an agent's scripts must pass before the scripts exist, and the test cases that exercise every approval and way back of a process.",
  "license": "Apache-2.0",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "write-a-suite",
    "prove-a-suite",
    "read-the-spec",
    "write-the-suite",
    "check-the-suite",
    "say-what-was-written",
    "write-test-cases",
    "write-the-cases",
    "check-the-cases"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "write-a-suite": {
            "scripts": [
              "scripts/job.mjs",
              "scripts/declared.mjs",
              "scripts/write-suite.mjs",
              "scripts/suite-rules.mjs",
              "scripts/spec-rules.mjs",
              "scripts/kept-interfaces.mjs",
              "scripts/carried.mjs",
              "scripts/model-caller.mjs",
              "scripts/check-suite.mjs",
              "scripts/reply.mjs",
              "scripts/went-without.mjs",
              "scripts/pieces.mjs",
              "scripts/agent-folder.mjs",
              "scripts/test-cases.mjs",
              "scripts/check-cases.mjs",
              "scripts/process-check.mjs"
            ],
            "references": [
              "references/what-a-good-suite-carries.md",
              "references/a-suite-that-works.test.mjs",
              "references/the-spec-it-tests.json",
              "references/delivered-formats.test.mjs",
              "references/records-per-job.test.mjs",
              "references/worked-values.test.mjs",
              "references/printed-reply.test.mjs",
              "references/kept-interfaces.test.mjs",
              "rules.md"
            ]
          },
          "prove-a-suite": {
            "scripts": [
              "scripts/declared.mjs",
              "scripts/check-suite.mjs",
              "scripts/reply.mjs",
              "scripts/went-without.mjs",
              "scripts/agent-folder.mjs"
            ],
            "references": [
              "rules.md"
            ]
          },
          "read-the-spec": {
            "scripts": [
              "scripts/declared.mjs",
              "scripts/agent-folder.mjs"
            ]
          },
          "write-the-suite": {
            "scripts": [
              "scripts/write-suite.mjs",
              "scripts/suite-rules.mjs",
              "scripts/spec-rules.mjs",
              "scripts/kept-interfaces.mjs",
              "scripts/carried.mjs",
              "scripts/model-caller.mjs",
              "scripts/check-suite.mjs",
              "scripts/declared.mjs",
              "scripts/went-without.mjs",
              "scripts/agent-folder.mjs"
            ],
            "references": [
              "references/what-a-good-suite-carries.md",
              "references/a-suite-that-works.test.mjs",
              "references/the-spec-it-tests.json",
              "references/delivered-formats.test.mjs",
              "references/records-per-job.test.mjs",
              "references/worked-values.test.mjs",
              "references/printed-reply.test.mjs",
              "references/kept-interfaces.test.mjs"
            ]
          },
          "check-the-suite": {
            "scripts": [
              "scripts/check-suite.mjs",
              "scripts/agent-folder.mjs"
            ]
          },
          "say-what-was-written": {
            "scripts": [
              "scripts/reply.mjs",
              "scripts/went-without.mjs"
            ]
          },
          "write-test-cases": {
            "scripts": [
              "scripts/job.mjs",
              "scripts/carried.mjs",
              "scripts/agent-folder.mjs",
              "scripts/test-cases.mjs",
              "scripts/check-cases.mjs",
              "scripts/process-check.mjs",
              "scripts/model-caller.mjs",
              "scripts/went-without.mjs"
            ],
            "references": [
              "rules.md"
            ]
          },
          "write-the-cases": {
            "scripts": [
              "scripts/test-cases.mjs",
              "scripts/model-caller.mjs",
              "scripts/process-check.mjs",
              "scripts/check-cases.mjs"
            ]
          },
          "check-the-cases": {
            "scripts": [
              "scripts/check-cases.mjs",
              "scripts/process-check.mjs"
            ]
          }
        }
      }
    }
  }
}
