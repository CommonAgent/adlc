{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "test-writer",
  "version": "0.7.1",
  "description": "Writes the test suite a package's scripts will have to pass, from the spec and before the scripts exist, and runs it against nothing to prove it asserts something; and writes Agent Processes 0.9.0 test cases for a process document that answer every approval each way and take every way back.",
  "license": "Apache-2.0",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "built-agent",
    "draft",
    "write-a-suite",
    "prove-a-suite",
    "read-the-spec",
    "write-the-suite",
    "check-the-suite",
    "say-what-was-written",
    "write-test-cases",
    "write-the-cases",
    "check-the-cases"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "write-a-suite": {
            "scripts": [
              "scripts/job.mjs",
              "scripts/declared.mjs",
              "scripts/write-suite.mjs",
              "scripts/model-caller.mjs",
              "scripts/check-suite.mjs",
              "scripts/reply.mjs",
              "scripts/went-without.mjs",
              "scripts/pieces.mjs",
              "scripts/agent-folder.mjs",
              "scripts/test-cases.mjs",
              "scripts/check-cases.mjs",
              "scripts/process-check.mjs"
            ],
            "references": [
              "references/what-a-good-suite-carries.md",
              "references/a-suite-that-works.test.mjs",
              "references/the-spec-it-tests.json",
              "references/delivered-formats.test.mjs",
              "references/records-per-job.test.mjs",
              "references/worked-values.test.mjs",
              "references/printed-reply.test.mjs",
              "rules.md"
            ]
          },
          "prove-a-suite": {
            "scripts": [
              "scripts/declared.mjs",
              "scripts/check-suite.mjs",
              "scripts/reply.mjs",
              "scripts/went-without.mjs",
              "scripts/agent-folder.mjs"
            ],
            "references": [
              "rules.md"
            ]
          },
          "read-the-spec": {
            "scripts": [
              "scripts/declared.mjs",
              "scripts/agent-folder.mjs"
            ]
          },
          "write-the-suite": {
            "scripts": [
              "scripts/write-suite.mjs",
              "scripts/model-caller.mjs",
              "scripts/check-suite.mjs",
              "scripts/declared.mjs",
              "scripts/went-without.mjs",
              "scripts/agent-folder.mjs"
            ],
            "references": [
              "references/what-a-good-suite-carries.md",
              "references/a-suite-that-works.test.mjs",
              "references/the-spec-it-tests.json",
              "references/delivered-formats.test.mjs",
              "references/records-per-job.test.mjs",
              "references/worked-values.test.mjs",
              "references/printed-reply.test.mjs"
            ]
          },
          "check-the-suite": {
            "scripts": [
              "scripts/check-suite.mjs",
              "scripts/agent-folder.mjs"
            ]
          },
          "say-what-was-written": {
            "scripts": [
              "scripts/reply.mjs",
              "scripts/went-without.mjs"
            ]
          },
          "write-test-cases": {
            "scripts": [
              "scripts/job.mjs",
              "scripts/agent-folder.mjs",
              "scripts/test-cases.mjs",
              "scripts/check-cases.mjs",
              "scripts/process-check.mjs",
              "scripts/model-caller.mjs",
              "scripts/went-without.mjs"
            ],
            "references": [
              "rules.md"
            ]
          },
          "write-the-cases": {
            "scripts": [
              "scripts/test-cases.mjs",
              "scripts/model-caller.mjs",
              "scripts/process-check.mjs",
              "scripts/check-cases.mjs"
            ]
          },
          "check-the-cases": {
            "scripts": [
              "scripts/check-cases.mjs",
              "scripts/process-check.mjs"
            ]
          }
        }
      }
    }
  }
}
