{
  "format": "agent-descriptor-v1",
  "agent_version": "2",
  "name": "Deployment manager",
  "summary": "Installs, updates and removes agents on a host from their packages, only when the owner asks, and records each change.",
  "does": "Turns an agent package into a running agent on this host, accounts for what is deployed, and removes agents cleanly, only when the owner asks.",
  "offerings": [
    {
      "id": "chat",
      "name": "Chat",
      "does": "Send a message; the local agent replies.",
      "inputs": [
        {
          "name": "the message",
          "kind": "text",
          "required": true,
          "given_by": "either"
        }
      ],
      "outputs": [
        {
          "name": "the reply",
          "kind": "text/markdown",
          "when": "per_task"
        }
      ],
      "started_by": [
        "person",
        "agent"
      ],
      "revisions": {
        "included": {
          "count": 1,
          "window_days": 14
        },
        "flat": {
          "model": "flat",
          "amount_micro": 0,
          "currency": "USD"
        }
      }
    },
    {
      "id": "role-deployment-manager",
      "name": "Deployment manager",
      "does": "Holds the deployment manager role (agentroles.ai): turns an agent package into a running agent on this host, on the owner's instruction only.",
      "inputs": [
        {
          "name": "the message",
          "kind": "text",
          "required": true,
          "given_by": "either"
        }
      ],
      "outputs": [
        {
          "name": "the reply",
          "kind": "text/markdown",
          "when": "per_task"
        }
      ],
      "started_by": [
        "person",
        "agent"
      ],
      "revisions": {
        "included": {
          "count": 1,
          "window_days": 14
        },
        "flat": {
          "model": "flat",
          "amount_micro": 0,
          "currency": "USD"
        }
      }
    },
    {
      "id": "interface-deployer",
      "name": "interface-deployer",
      "does": "Answers the deployer exchanges: deploy this, what is deployed, how did it go, update it, remove it.",
      "inputs": [
        {
          "name": "the message",
          "kind": "text",
          "required": true,
          "given_by": "either"
        }
      ],
      "outputs": [
        {
          "name": "the reply",
          "kind": "text/markdown",
          "when": "per_task"
        }
      ],
      "started_by": [
        "person",
        "agent"
      ],
      "revisions": {
        "included": {
          "count": 1,
          "window_days": 14
        },
        "flat": {
          "model": "flat",
          "amount_micro": 0,
          "currency": "USD"
        }
      }
    },
    {
      "id": "install-a-process",
      "name": "Install a process",
      "does": "Installs a signed process the owner approved: checks the package maker's record against the bundle, has the platform file the document with the organization's processes, publish it as a solution and bind its trigger or schedule, and signs a deployment record.",
      "inputs": [
        {
          "name": "process bundle",
          "kind": "application/vnd.agentmesh.process-bundle+json",
          "required": true,
          "given_by": "agent"
        },
        {
          "name": "build record",
          "kind": "application/vnd.agentmesh.process-build-record+json",
          "required": true,
          "given_by": "agent"
        },
        {
          "name": "the install request",
          "kind": "identifier",
          "required": true,
          "given_by": "agent"
        }
      ],
      "outputs": [
        {
          "name": "deployment record",
          "kind": "application/vnd.agentmesh.process-deployment-record+json",
          "when": "per_task"
        },
        {
          "name": "process bundle",
          "kind": "application/vnd.agentmesh.process-bundle+json",
          "when": "per_task"
        }
      ],
      "started_by": [
        "person",
        "agent"
      ],
      "revisions": {
        "included": {
          "count": 1,
          "window_days": 14
        },
        "flat": {
          "model": "flat",
          "amount_micro": 0,
          "currency": "USD"
        }
      }
    },
    {
      "id": "retire-a-process",
      "name": "Retire a process",
      "does": "Retires an installed process the owner said to retire: its schedule unbound, the solution it was published as removed, the document taken out of the organization's processes, and a signed deployment record.",
      "inputs": [
        {
          "name": "the install request",
          "kind": "identifier",
          "required": true,
          "given_by": "agent"
        }
      ],
      "outputs": [
        {
          "name": "deployment record",
          "kind": "application/vnd.agentmesh.process-deployment-record+json",
          "when": "per_task"
        }
      ],
      "started_by": [
        "person",
        "agent"
      ],
      "revisions": {
        "included": {
          "count": 1,
          "window_days": 14
        },
        "flat": {
          "model": "flat",
          "amount_micro": 0,
          "currency": "USD"
        }
      }
    }
  ],
  "interaction": "service",
  "refusals": "Calls fixed procedures and nothing else; a step the procedures refuse is a step it does not take another way. Acts only on the owner's instruction. A request its three procedures cannot meet is refused with the reason.",
  "will_not": [
    "It will not deploy, update or remove an agent unless the owner asks.",
    "It will not take a step its fixed procedures refuse, by any other route.",
    "It will not deploy to production without a current audit pass for that exact package."
  ],
  "role": "role-deployment-manager",
  "interfaces": [
    "interface-deployer"
  ],
  "fleet": false,
  "hosted_in": [
    "us"
  ],
  "can_use": []
}
