{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "doc-writer",
  "version": "0.1.0",
  "description": "Writes the documentation a person reads to use an agent: what it does, where to send it work, what each job takes and hands back, what it will not do, reaches, costs and leaves behind, with examples from its records. It writes only from the agent's descriptor, its AgentDoc, its records and the verdicts about it, marks every line with the place it came from, and lists everything those sources are silent on.",
  "license": "Apache-2.0",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "built-agent",
    "document-a-package",
    "read-what-was-given",
    "write-the-documentation",
    "check-every-line",
    "hand-it-over"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "document-a-package": {
            "scripts": [
              "scripts/document.mjs",
              "scripts/given.mjs",
              "scripts/templates.mjs",
              "scripts/write-docs.mjs",
              "scripts/check-docs.mjs",
              "scripts/pieces.mjs",
              "scripts/went-without.mjs"
            ],
            "references": [
              "references/how-a-line-is-traced.md",
              "rules.md"
            ]
          },
          "read-what-was-given": {
            "scripts": [
              "scripts/given.mjs"
            ]
          },
          "write-the-documentation": {
            "scripts": [
              "scripts/write-docs.mjs",
              "scripts/given.mjs",
              "scripts/templates.mjs"
            ],
            "references": [
              "references/how-a-line-is-traced.md"
            ]
          },
          "check-every-line": {
            "scripts": [
              "scripts/check-docs.mjs",
              "scripts/write-docs.mjs",
              "scripts/given.mjs",
              "scripts/templates.mjs"
            ],
            "references": [
              "references/how-a-line-is-traced.md"
            ]
          },
          "hand-it-over": {
            "scripts": [
              "scripts/pieces.mjs",
              "scripts/went-without.mjs"
            ]
          }
        }
      }
    }
  }
}
