{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "publisher",
  "version": "0.2.4",
  "description": "Puts the finished files you give it at a public address, checks what is served matches, and hands back the address.",
  "license": "Apache-2.0",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "publish",
    "read-what-was-given",
    "place-the-files",
    "check-what-is-served"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "publish": {
            "scripts": [
              "scripts/publish.mjs",
              "scripts/place.mjs",
              "scripts/inspect.mjs",
              "scripts/pieces.mjs"
            ],
            "references": [
              "references/what-it-will-not-publish.md"
            ]
          },
          "read-what-was-given": {
            "scripts": [
              "scripts/inspect.mjs"
            ],
            "references": [
              "references/what-it-will-not-publish.md"
            ]
          },
          "place-the-files": {
            "scripts": [
              "scripts/place.mjs"
            ]
          },
          "check-what-is-served": {
            "scripts": [
              "scripts/place.mjs"
            ]
          }
        }
      }
    }
  }
}
