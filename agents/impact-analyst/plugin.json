{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "impact-analyst",
  "version": "0.1.3",
  "description": "Tells you what a change to an agent touches before it is built: every dependent, and whether the change is compatible, breaking or a change of behavior for each.",
  "license": "Apache-2.0",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "agent-change",
    "read-the-change",
    "compare-the-declarations",
    "answer-each-dependent",
    "file-what-is-owed",
    "write-the-report"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "agent-change": {
            "scripts": [
              "scripts/analyze.mjs",
              "scripts/read-change.mjs",
              "scripts/kinds.mjs",
              "scripts/compare.mjs",
              "scripts/answer.mjs",
              "scripts/ledger.mjs",
              "scripts/report.mjs",
              "scripts/pieces.mjs",
              "scripts/went-without.mjs"
            ],
            "references": [
              "references/how-each-change-is-answered.md",
              "rules.md"
            ]
          },
          "read-the-change": {
            "scripts": [
              "scripts/read-change.mjs",
              "scripts/kinds.mjs"
            ]
          },
          "compare-the-declarations": {
            "scripts": [
              "scripts/compare.mjs",
              "scripts/kinds.mjs"
            ],
            "references": [
              "references/how-each-change-is-answered.md"
            ]
          },
          "answer-each-dependent": {
            "scripts": [
              "scripts/answer.mjs",
              "scripts/kinds.mjs"
            ],
            "references": [
              "references/how-each-change-is-answered.md"
            ]
          },
          "file-what-is-owed": {
            "scripts": [
              "scripts/ledger.mjs",
              "scripts/compare.mjs",
              "scripts/answer.mjs",
              "scripts/kinds.mjs"
            ]
          },
          "write-the-report": {
            "scripts": [
              "scripts/report.mjs",
              "scripts/pieces.mjs",
              "scripts/went-without.mjs",
              "scripts/answer.mjs",
              "scripts/compare.mjs",
              "scripts/kinds.mjs"
            ]
          }
        }
      }
    }
  }
}
