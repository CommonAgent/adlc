{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "publisher",
  "version": "0.2.2",
  "description": "Puts finished files where a person can open them. It writes under the one folder it was bound to and nowhere else, reads every byte before it goes, and reads back what is served to check it matches what it was handed. It answers with the address and the digest of what is there.",
  "license": "Apache-2.0",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "built-agent",
    "draft",
    "publish",
    "read-what-was-given",
    "place-the-files",
    "check-what-is-served"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "publish": {
            "scripts": [
              "scripts/publish.mjs",
              "scripts/place.mjs",
              "scripts/inspect.mjs",
              "scripts/pieces.mjs"
            ],
            "references": [
              "references/what-it-will-not-publish.md"
            ]
          },
          "read-what-was-given": {
            "scripts": [
              "scripts/inspect.mjs"
            ],
            "references": [
              "references/what-it-will-not-publish.md"
            ]
          },
          "place-the-files": {
            "scripts": [
              "scripts/place.mjs"
            ]
          },
          "check-what-is-served": {
            "scripts": [
              "scripts/place.mjs"
            ]
          }
        }
      }
    }
  }
}
