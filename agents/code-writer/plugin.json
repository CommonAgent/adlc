{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "code-writer",
  "version": "0.4.0",
  "description": "Writes the scripts a spec names until the test suite passes, and hands back the scripts with an account of how it got there.",
  "license": "Apache-2.0",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "write-the-scripts",
    "lay-out-the-workspace",
    "check-the-work",
    "report-the-work",
    "hand-off-the-code",
    "lay-out-the-build-folder",
    "write-the-house-rules",
    "pack-the-build-folder"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "kind": "plugin-on-harness",
        "skills": {
          "write-the-scripts": {
            "scripts": [
              "scripts/workspace.mjs",
              "scripts/check.mjs",
              "scripts/report.mjs",
              "scripts/pieces.mjs",
              "scripts/verify.mjs",
              "scripts/went-without.mjs",
              "scripts/agent-folder.mjs",
              "scripts/archive.mjs"
            ],
            "references": [
              "references/what-the-house-stack-is.md",
              "references/a-package-that-works",
              "rules.md"
            ]
          },
          "lay-out-the-workspace": {
            "scripts": [
              "scripts/workspace.mjs",
              "scripts/agent-folder.mjs",
              "scripts/archive.mjs"
            ]
          },
          "check-the-work": {
            "scripts": [
              "scripts/check.mjs",
              "scripts/workspace.mjs",
              "scripts/agent-folder.mjs"
            ]
          },
          "report-the-work": {
            "scripts": [
              "scripts/report.mjs",
              "scripts/pieces.mjs",
              "scripts/went-without.mjs"
            ]
          },
          "hand-off-the-code": {
            "scripts": [
              "scripts/handoff.mjs",
              "scripts/archive.mjs",
              "scripts/workspace.mjs",
              "scripts/agent-folder.mjs",
              "scripts/check.mjs"
            ],
            "references": [
              "references/agents-md-template.md"
            ]
          },
          "lay-out-the-build-folder": {
            "scripts": [
              "scripts/handoff.mjs",
              "scripts/workspace.mjs",
              "scripts/agent-folder.mjs",
              "scripts/check.mjs",
              "scripts/archive.mjs"
            ]
          },
          "write-the-house-rules": {
            "scripts": [
              "scripts/handoff.mjs"
            ],
            "references": [
              "references/agents-md-template.md"
            ]
          },
          "pack-the-build-folder": {
            "scripts": [
              "scripts/archive.mjs",
              "scripts/handoff.mjs"
            ]
          }
        }
      }
    }
  }
}
