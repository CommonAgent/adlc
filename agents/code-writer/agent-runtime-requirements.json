{
  "format": "agent-runtime-requirements-v1",
  "runtimes": [
    {
      "name": "node",
      "version": ">=22"
    }
  ],
  "binaries": [],
  "dependencies": [],
  "systems": [],
  "ceilings": [],
  "directories": [
    {
      "name": "records",
      "purpose": "the workspace record, every round, the verdict, the account and the conflict for each job"
    },
    {
      "name": "work",
      "purpose": "the workspace the scripts are written in, one per job"
    }
  ],
  "job_seconds": 2400,
  "wants_replies": true,
  "price": {
    "sku": "default",
    "covers": {
      "offerings": [
        "write-the-scripts"
      ]
    },
    "price": {
      "model": "flat",
      "amount_micro": 2000000,
      "currency": "USD"
    }
  },
  "run": {
    "hand-off-the-code": {
      "command": [
        "node",
        "{home}/{package}/skills/hand-off-the-code/scripts/handoff.mjs",
        "--job",
        "{job_dir}",
        "--records",
        "{records}",
        "--work",
        "{work}",
        "--message",
        "{job_dir}/message.txt"
      ],
      "reply": "json:reply",
      "escalate_when": "json:escalate",
      "per_file": [
        "--file",
        "{file_path}::{file_media_type}"
      ],
      "message_file": "{job_dir}/message.txt"
    }
  },
  "verify": "skills/write-the-scripts/scripts/verify.mjs"
}
