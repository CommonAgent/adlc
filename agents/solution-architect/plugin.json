{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "solution-architect",
  "version": "0.5.0",
  "description": "Writes the architecture record for a new agent: the systems it reaches, the product bound to each, and every decision with its reason.",
  "license": "Apache-2.0",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "architecture",
    "write-the-architecture",
    "revise-the-architecture",
    "read-what-was-asked",
    "name-the-systems",
    "bind-each-environment",
    "check-the-record",
    "write-the-reply"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "write-the-architecture": {
            "scripts": [
              "scripts/asked.mjs",
              "scripts/name.mjs",
              "scripts/model-caller.mjs",
              "scripts/standard.mjs",
              "scripts/options.mjs",
              "scripts/bind.mjs",
              "scripts/architecture-record.mjs",
              "scripts/standing.mjs",
              "scripts/check-record.mjs",
              "scripts/reply.mjs",
              "scripts/pieces.mjs",
              "scripts/went-without.mjs",
              "scripts/settled.mjs",
              "scripts/no-provider.mjs",
              "scripts/views.mjs"
            ],
            "references": [
              "../../standards/architecture-standard.md",
              "references/house-stack.json",
              "references/a-record-that-works.md",
              "rules.md",
              "../../standards/standing-asset-schemas.json"
            ]
          },
          "revise-the-architecture": {
            "scripts": [
              "scripts/asked.mjs",
              "scripts/name.mjs",
              "scripts/model-caller.mjs",
              "scripts/standard.mjs",
              "scripts/options.mjs",
              "scripts/bind.mjs",
              "scripts/architecture-record.mjs",
              "scripts/standing.mjs",
              "scripts/check-record.mjs",
              "scripts/reply.mjs",
              "scripts/pieces.mjs",
              "scripts/went-without.mjs",
              "scripts/settled.mjs",
              "scripts/no-provider.mjs",
              "scripts/views.mjs"
            ],
            "references": [
              "../../standards/architecture-standard.md",
              "references/house-stack.json",
              "references/a-record-that-works.md",
              "rules.md",
              "../../standards/standing-asset-schemas.json"
            ]
          },
          "read-what-was-asked": {
            "scripts": [
              "scripts/asked.mjs",
              "scripts/architecture-record.mjs",
              "scripts/bind.mjs",
              "scripts/went-without.mjs",
              "scripts/settled.mjs",
              "scripts/no-provider.mjs"
            ],
            "references": [
              "references/house-stack.json"
            ]
          },
          "name-the-systems": {
            "scripts": [
              "scripts/name.mjs",
              "scripts/model-caller.mjs",
              "scripts/standard.mjs",
              "scripts/options.mjs",
              "scripts/architecture-record.mjs",
              "scripts/settled.mjs",
              "scripts/no-provider.mjs",
              "scripts/views.mjs"
            ],
            "references": [
              "../../standards/architecture-standard.md",
              "references/a-record-that-works.md"
            ]
          },
          "bind-each-environment": {
            "scripts": [
              "scripts/bind.mjs",
              "scripts/architecture-record.mjs",
              "scripts/no-provider.mjs"
            ],
            "references": [
              "references/house-stack.json"
            ]
          },
          "check-the-record": {
            "scripts": [
              "scripts/standing.mjs",
              "scripts/check-record.mjs",
              "scripts/architecture-record.mjs",
              "scripts/standard.mjs",
              "scripts/options.mjs",
              "scripts/no-provider.mjs",
              "scripts/views.mjs"
            ],
            "references": [
              "../../standards/architecture-standard.md",
              "../../standards/standing-asset-schemas.json"
            ]
          },
          "write-the-reply": {
            "scripts": [
              "scripts/reply.mjs",
              "scripts/pieces.mjs",
              "scripts/architecture-record.mjs",
              "scripts/went-without.mjs",
              "scripts/no-provider.mjs"
            ]
          }
        }
      }
    }
  }
}
