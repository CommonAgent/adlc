{
  "format": "agent-runtime-requirements-v1",
  "runtimes": [
    {
      "name": "node"
    }
  ],
  "binaries": [
    {
      "name": "coding-harness",
      "purpose": "The coding harness command, installed on the host with the ADLC plugin, that the agent runs headless on each build folder: it takes a prompt and, to resume, a session id, and answers with JSON that carries the result and the session id."
    }
  ],
  "dependencies": [],
  "systems": [],
  "ceilings": [],
  "directories": [
    {
      "name": "records",
      "purpose": "every record the descriptor names"
    },
    {
      "name": "work",
      "purpose": "inputs and drafts in progress"
    }
  ],
  "price": {
    "sku": "default",
    "covers": {
      "agent": true
    },
    "price": {
      "model": "free"
    }
  },
  "run": {
    "build-an-agent": {
      "command": [
        "node",
        "{home}/{package}/skills/build-an-agent/scripts/build-an-agent.mjs",
        "--job",
        "{job_dir}",
        "--records",
        "{records}",
        "--work",
        "{work}",
        "--text-file",
        "{job_dir}/message.txt"
      ],
      "reply": "json:reply"
    }
  }
}
