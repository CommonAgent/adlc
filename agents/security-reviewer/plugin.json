{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "security-reviewer",
  "version": "0.2.2",
  "description": "Reviews an Agent Package before it is installed and before any credential is bound to it, and writes down what the agent may reach, what it may spend and what it must never do, with the reason for each. It flags every permission the package asks for that has no recorded reason, refuses a package whose programs reach a system its declaration does not name or whose owner set no spending limit, lists as a warning every network address written into its scripts, and lists what it lets through knowingly. It grants nothing and changes nothing.",
  "license": "Apache-2.0",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "built-agent",
    "draft",
    "review-a-package",
    "read-the-package",
    "trace-the-programs",
    "weigh-the-reasons",
    "write-the-review"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "review-a-package": {
            "scripts": [
              "scripts/review-package.mjs",
              "scripts/read-package.mjs",
              "scripts/tar.mjs",
              "scripts/trace-programs.mjs",
              "scripts/architecture.mjs",
              "scripts/assess.mjs",
              "scripts/platform.mjs",
              "scripts/secrets.mjs",
              "scripts/weigh.mjs",
              "scripts/model-caller.mjs",
              "scripts/model-record.mjs",
              "scripts/write-review.mjs",
              "scripts/went-without.mjs",
              "scripts/pieces.mjs"
            ],
            "references": [
              "rules.md",
              "references/what-a-review-holds.md",
              "references/what-the-platform-holds-it-to.md"
            ]
          },
          "read-the-package": {
            "scripts": [
              "scripts/read-package.mjs",
              "scripts/tar.mjs",
              "scripts/secrets.mjs"
            ]
          },
          "trace-the-programs": {
            "scripts": [
              "scripts/trace-programs.mjs",
              "scripts/architecture.mjs"
            ],
            "references": [
              "references/what-the-platform-holds-it-to.md"
            ]
          },
          "weigh-the-reasons": {
            "scripts": [
              "scripts/weigh.mjs",
              "scripts/model-caller.mjs",
              "scripts/model-record.mjs"
            ],
            "references": [
              "rules.md"
            ]
          },
          "write-the-review": {
            "scripts": [
              "scripts/assess.mjs",
              "scripts/platform.mjs",
              "scripts/write-review.mjs",
              "scripts/pieces.mjs",
              "scripts/went-without.mjs"
            ],
            "references": [
              "references/what-a-review-holds.md",
              "references/what-the-platform-holds-it-to.md"
            ]
          }
        }
      }
    }
  }
}
