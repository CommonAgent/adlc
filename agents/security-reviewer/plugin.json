{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "security-reviewer",
  "version": "0.3.3",
  "description": "Reviews an agent package before it is installed and writes down what it may reach, what it may spend and what it must never do, with a reason for each.",
  "license": "Apache-2.0",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "review-a-package",
    "read-the-package",
    "trace-the-programs",
    "weigh-the-reasons",
    "write-the-review",
    "review-a-process",
    "read-the-process",
    "check-the-process-rules"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "review-a-package": {
            "scripts": [
              "scripts/review-package.mjs",
              "scripts/read-package.mjs",
              "scripts/tar.mjs",
              "scripts/trace-programs.mjs",
              "scripts/architecture.mjs",
              "scripts/assess.mjs",
              "scripts/platform.mjs",
              "scripts/secrets.mjs",
              "scripts/weigh.mjs",
              "scripts/model-caller.mjs",
              "scripts/model-record.mjs",
              "scripts/write-review.mjs",
              "scripts/went-without.mjs",
              "scripts/pieces.mjs",
              "scripts/review-process.mjs",
              "scripts/process-rules.mjs",
              "scripts/process-check.mjs"
            ],
            "references": [
              "rules.md",
              "references/what-a-review-holds.md",
              "references/what-the-platform-holds-it-to.md"
            ]
          },
          "read-the-package": {
            "scripts": [
              "scripts/read-package.mjs",
              "scripts/tar.mjs",
              "scripts/secrets.mjs"
            ]
          },
          "trace-the-programs": {
            "scripts": [
              "scripts/trace-programs.mjs",
              "scripts/architecture.mjs"
            ],
            "references": [
              "references/what-the-platform-holds-it-to.md"
            ]
          },
          "weigh-the-reasons": {
            "scripts": [
              "scripts/weigh.mjs",
              "scripts/model-caller.mjs",
              "scripts/model-record.mjs"
            ],
            "references": [
              "rules.md"
            ]
          },
          "write-the-review": {
            "scripts": [
              "scripts/assess.mjs",
              "scripts/platform.mjs",
              "scripts/write-review.mjs",
              "scripts/pieces.mjs",
              "scripts/went-without.mjs"
            ],
            "references": [
              "references/what-a-review-holds.md",
              "references/what-the-platform-holds-it-to.md"
            ]
          },
          "review-a-process": {
            "scripts": [
              "scripts/review-process.mjs",
              "scripts/process-rules.mjs",
              "scripts/process-check.mjs"
            ]
          },
          "read-the-process": {
            "scripts": [
              "scripts/review-process.mjs",
              "scripts/process-check.mjs"
            ]
          },
          "check-the-process-rules": {
            "scripts": [
              "scripts/review-process.mjs",
              "scripts/process-rules.mjs",
              "scripts/process-check.mjs"
            ]
          }
        }
      }
    }
  }
}
