{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "incident-recorder",
  "version": "0.1.5",
  "description": "Records an incident when a fleet agent goes quiet or a job fails. Reads platform activity records and the agent's own records around the failure window, builds a strict chronological timeline of known facts and gaps, and writes an incident record attributing every fact to its source. Never guesses causes, never proposes fixes, and never contacts the agent.",
  "license": "Apache-2.0",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "built-agent",
    "draft",
    "record-incident",
    "read-records",
    "build-timeline",
    "write-incident-record"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "record-incident": {
            "scripts": [
              "scripts/record-incident.mjs",
              "scripts/declines.mjs",
              "scripts/read-records.mjs",
              "scripts/build-timeline.mjs",
              "scripts/write-incident.mjs",
              "scripts/went-without.mjs",
              "scripts/pieces.mjs"
            ]
          },
          "read-records": {
            "scripts": [
              "scripts/read-records.mjs",
              "scripts/went-without.mjs"
            ]
          },
          "build-timeline": {
            "scripts": [
              "scripts/build-timeline.mjs",
              "scripts/went-without.mjs"
            ]
          },
          "write-incident-record": {
            "scripts": [
              "scripts/write-incident.mjs",
              "scripts/went-without.mjs"
            ]
          }
        }
      }
    }
  }
}
