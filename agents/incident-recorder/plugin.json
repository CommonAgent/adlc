{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "incident-recorder",
  "version": "0.1.5",
  "description": "Writes the record of an incident when an agent goes quiet or a job fails: a timeline of what the records show, each fact with its source.",
  "license": "Apache-2.0",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "record-incident",
    "read-records",
    "build-timeline",
    "write-incident-record"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "record-incident": {
            "scripts": [
              "scripts/record-incident.mjs",
              "scripts/declines.mjs",
              "scripts/read-records.mjs",
              "scripts/build-timeline.mjs",
              "scripts/write-incident.mjs",
              "scripts/went-without.mjs",
              "scripts/pieces.mjs"
            ]
          },
          "read-records": {
            "scripts": [
              "scripts/read-records.mjs",
              "scripts/went-without.mjs"
            ]
          },
          "build-timeline": {
            "scripts": [
              "scripts/build-timeline.mjs",
              "scripts/went-without.mjs"
            ]
          },
          "write-incident-record": {
            "scripts": [
              "scripts/write-incident.mjs",
              "scripts/went-without.mjs"
            ]
          }
        }
      }
    }
  }
}
