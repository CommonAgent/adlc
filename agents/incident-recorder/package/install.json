{
  "format": "agent-install-v1",
  "runtimes": [
    {
      "name": "node",
      "version": ">=22"
    }
  ],
  "binaries": [],
  "dependencies": [],
  "systems": [],
  "ceilings": [],
  "directories": [
    {
      "name": "records",
      "purpose": "one folder per job, holding the incident record, timeline, record inventory, and went-without notes"
    }
  ],
  "job_seconds": 300,
  "price": {
    "sku": "default",
    "covers": {
      "offerings": [
        "record-incident"
      ]
    },
    "price": {
      "model": "free"
    }
  },
  "run": {
    "record-incident": {
      "command": [
        "node",
        "{home}/{package}/skills/record-incident/scripts/record-incident.mjs",
        "--job",
        "{job_dir}",
        "--records",
        "{records}",
        "--work",
        "{work}",
        "--text-file",
        "{job_dir}/message.txt"
      ],
      "reply": "json:reply",
      "message_file": "{job_dir}/message.txt"
    }
  }
}
