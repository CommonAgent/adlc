#!/bin/bash
# The package maker's brain: a run's work is done mechanically, anything else goes to Codex.
#
# When the framed prompt carries a spec among its attached files (the lifecycle's
# make-the-package phase), the pack procedure builds the package from those files
# and answers in one sentence; no model is woken, because on 2026-09-15 the model,
# given the same files, passed the spec alone and then ran out of its four minutes.
# The pack exits 3 when the prompt is not a run's work, and Codex takes the turn as
# before.
#
# --sandbox workspace-write ON PURPOSE for the Codex path: see the deployment
# manager's brain for why.
#
# The model is Claude on Vertex AI (owner, 2026-10-03). Codex
# speaks only the Responses API, so it reaches Claude through the host's responses
# bridge (127.0.0.1:8788, the pm2 app `responses-bridge`, which signs in as the VM's
# own service account). No key is read here.
VERTEX=(-c 'model="claude-sonnet-5-5"' -c 'model_provider="vertex"'
  -c 'model_providers.vertex={ name = "Claude on Vertex AI (fleet bridge)", base_url = "http://127.0.0.1:8788/v1", wire_api = "responses" }')
# THE OFFICIAL CODER'S DOOR. Only scripts the code-writer delivered can be
# packed: the builder checks every script against the signed delivery
# manifest when this is set. The value is the code-writer's public key.
export OFFICIAL_CODER="{{pinned_keys.official_coder}}"
cd "$HOME" || exit 1
prompt=$(mktemp)
printf '%s' "$1" > "$prompt"
# The pack runs as the ops node's user, which alone can read this agent's
# folder on the node (technical debt 112, 2026-09-29).
chmod 0644 "$prompt"
if sudo -n -H -u mesh-node /opt/fleet/agentbuilder-pack-as-node.sh "$prompt"; then
  rm -f "$prompt"
  exit 0
elif [ $? -ne 3 ]; then
  rm -f "$prompt"
  exit 0
fi
rm -f "$prompt"
out=$(mktemp)
/usr/bin/codex exec "${VERTEX[@]}" --skip-git-repo-check --sandbox workspace-write \
  --output-last-message "$out" "$1" >/dev/null 2>&1 </dev/null
cat "$out"
rm -f "$out"
