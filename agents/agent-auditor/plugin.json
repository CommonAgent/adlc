{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "agent-auditor",
  "version": "0.4.0",
  "description": "Audits one built agent version, named by its handle and its version or package digest, against an audit checklist: the standards/audit-checklist.md it carries, or one it is given. For each lifecycle stage it finds the stage's record and checks it is present, signed by whoever made it and bound to the package digest. It runs every checklist entry through the test registered for it, reusing the package maker's own checks, the platform's rule against model names in code, the test writer's delivered-formats check and the registry's signed Descriptor, reads the agent as it runs on dev and prod, and reads a usability report and the App walk's verdict when they are given. A check with no registered test is reported as not checked, never skipped. It files each finding as a debt in the platform's ledger, routed to the stage that fixes it, and hands back one signed audit report, which it files where the Deployment Manager and the Catalog read it by package digest. It calls no model and approves nothing. It holds the audit role for the Prove phase of the Agent Development Lifecycle.",
  "license": "Apache-2.0",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "built-agent",
    "audit-an-agent",
    "read-the-request",
    "check-the-stage-records",
    "run-the-checks",
    "file-the-findings",
    "write-the-report"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "audit-an-agent": {
            "scripts": [
              "scripts/audit.mjs",
              "scripts/read-request.mjs",
              "scripts/checklist.mjs",
              "scripts/gather.mjs",
              "scripts/platform.mjs",
              "scripts/tar.mjs",
              "scripts/keys.mjs",
              "scripts/stages.mjs",
              "scripts/checks.mjs",
              "scripts/models.mjs",
              "scripts/formats.mjs",
              "scripts/package-maker.mjs",
              "scripts/ledger.mjs",
              "scripts/report.mjs",
              "scripts/store.mjs",
              "scripts/pieces.mjs",
              "scripts/went-without.mjs"
            ],
            "references": [
              "../../standards/audit-checklist.md",
              "../../standards/standing-asset-schemas.json",
              "references/stage-holders.json",
              "references/how-each-stage-and-check-is-read.md",
              "rules.md"
            ]
          },
          "read-the-request": {
            "scripts": [
              "scripts/read-request.mjs",
              "scripts/gather.mjs",
              "scripts/platform.mjs",
              "scripts/tar.mjs",
              "scripts/keys.mjs"
            ],
            "references": [
              "references/stage-holders.json"
            ]
          },
          "check-the-stage-records": {
            "scripts": [
              "scripts/stages.mjs",
              "scripts/keys.mjs"
            ],
            "references": [
              "references/stage-holders.json",
              "references/how-each-stage-and-check-is-read.md"
            ]
          },
          "run-the-checks": {
            "scripts": [
              "scripts/checks.mjs",
              "scripts/checklist.mjs",
              "scripts/models.mjs",
              "scripts/formats.mjs",
              "scripts/package-maker.mjs",
              "scripts/keys.mjs",
              "scripts/gather.mjs"
            ],
            "references": [
              "../../standards/audit-checklist.md",
              "../../standards/standing-asset-schemas.json",
              "references/how-each-stage-and-check-is-read.md"
            ]
          },
          "file-the-findings": {
            "scripts": [
              "scripts/ledger.mjs"
            ]
          },
          "write-the-report": {
            "scripts": [
              "scripts/report.mjs",
              "scripts/keys.mjs",
              "scripts/store.mjs",
              "scripts/pieces.mjs",
              "scripts/went-without.mjs"
            ]
          }
        }
      }
    }
  }
}
