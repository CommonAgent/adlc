{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "agent-auditor",
  "version": "0.4.3",
  "description": "Audits one built agent version against an audit checklist and hands back a signed report, with each finding routed to the stage that fixes it.",
  "license": "Apache-2.0",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "audit-an-agent",
    "read-the-request",
    "check-the-stage-records",
    "run-the-checks",
    "file-the-findings",
    "write-the-report"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "audit-an-agent": {
            "scripts": [
              "scripts/audit.mjs",
              "scripts/read-request.mjs",
              "scripts/checklist.mjs",
              "scripts/gather.mjs",
              "scripts/platform.mjs",
              "scripts/tar.mjs",
              "scripts/keys.mjs",
              "scripts/stages.mjs",
              "scripts/checks.mjs",
              "scripts/models.mjs",
              "scripts/formats.mjs",
              "scripts/package-maker.mjs",
              "scripts/ledger.mjs",
              "scripts/report.mjs",
              "scripts/store.mjs",
              "scripts/pieces.mjs",
              "scripts/went-without.mjs"
            ],
            "references": [
              "../../standards/audit-checklist.md",
              "../../standards/standing-asset-schemas.json",
              "references/stage-holders.json",
              "references/how-each-stage-and-check-is-read.md",
              "rules.md"
            ]
          },
          "read-the-request": {
            "scripts": [
              "scripts/read-request.mjs",
              "scripts/gather.mjs",
              "scripts/platform.mjs",
              "scripts/tar.mjs",
              "scripts/keys.mjs"
            ],
            "references": [
              "references/stage-holders.json"
            ]
          },
          "check-the-stage-records": {
            "scripts": [
              "scripts/stages.mjs",
              "scripts/keys.mjs"
            ],
            "references": [
              "references/stage-holders.json",
              "references/how-each-stage-and-check-is-read.md"
            ]
          },
          "run-the-checks": {
            "scripts": [
              "scripts/checks.mjs",
              "scripts/checklist.mjs",
              "scripts/models.mjs",
              "scripts/formats.mjs",
              "scripts/package-maker.mjs",
              "scripts/keys.mjs",
              "scripts/gather.mjs"
            ],
            "references": [
              "../../standards/audit-checklist.md",
              "../../standards/standing-asset-schemas.json",
              "references/how-each-stage-and-check-is-read.md"
            ]
          },
          "file-the-findings": {
            "scripts": [
              "scripts/ledger.mjs"
            ]
          },
          "write-the-report": {
            "scripts": [
              "scripts/report.mjs",
              "scripts/keys.mjs",
              "scripts/store.mjs",
              "scripts/pieces.mjs",
              "scripts/went-without.mjs"
            ]
          }
        }
      }
    }
  }
}
