{
  "format": "agent-runtime-requirements-v1",
  "runtimes": [
    {
      "name": "node",
      "version": ">=22"
    }
  ],
  "binaries": [],
  "dependencies": [],
  "systems": [
    {
      "name": "text-reasoning",
      "kind": "model",
      "protocols": [
        "anthropic-messages"
      ]
    }
  ],
  "ceilings": [],
  "directories": [
    {
      "name": "records",
      "purpose": "what was given, the house-rule check, the model's review, the check of its findings, the calls and the findings document, for each job"
    },
    {
      "name": "work",
      "purpose": "nothing is written here today; kept so the job command has the folder every lifecycle agent is given"
    }
  ],
  "job_seconds": 900,
  "wants_replies": true,
  "price": {
    "sku": "default",
    "covers": {
      "offerings": [
        "review-a-change"
      ]
    },
    "price": {
      "model": "free"
    }
  },
  "run": {
    "review-a-change": {
      "command": [
        "node",
        "{home}/{package}/skills/review-a-change/scripts/job.mjs",
        "--job",
        "{job_dir}",
        "--records",
        "{records}",
        "--work",
        "{work}",
        "--text-file",
        "{job_dir}/message.txt"
      ],
      "reply": "json:reply",
      "per_file": [
        "--file",
        "{file_path}::{file_media_type}"
      ],
      "message_file": "{job_dir}/message.txt"
    }
  }
}
