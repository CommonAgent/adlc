{
  "format": "agent-descriptor-v1",
  "agent_version": "1.0.0",
  "name": "Page reader",
  "offerings": [
    {
      "id": "read-the-pages",
      "name": "Read the pages",
      "outputs": [
        {
          "name": "pages",
          "kind": "application/vnd.example.pages+json",
          "label": "The pages read"
        }
      ],
      "steps": [
        {
          "id": "read-each-page",
          "name": "Read each page"
        }
      ]
    }
  ],
  "run_config": {
    "settings": [
      {
        "name": "count",
        "kind": "preference",
        "default": 3,
        "label": "How many pages"
      }
    ]
  }
}
