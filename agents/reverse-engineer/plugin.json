{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "reverse-engineer",
  "version": "0.3.2",
  "description": "Writes down what an existing codebase is, at a named commit: its behaviors, architecture, interfaces, dependencies and tests, each claim with its file and line.",
  "license": "Apache-2.0",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "reverse-engineer",
    "read-the-codebase",
    "list-the-dependencies",
    "run-the-baseline",
    "draft-from-the-code",
    "check-the-evidence",
    "write-the-record"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "reverse-engineer": {
            "scripts": [
              "scripts/describe.mjs",
              "scripts/read-request.mjs",
              "scripts/run-config.mjs",
              "scripts/archive.mjs",
              "scripts/codebase.mjs",
              "scripts/facts.mjs",
              "scripts/surface.mjs",
              "scripts/js-source.mjs",
              "scripts/declarations.mjs",
              "scripts/flags.mjs",
              "scripts/carried.mjs",
              "scripts/sbom.mjs",
              "scripts/baseline.mjs",
              "scripts/draft.mjs",
              "scripts/kinds.mjs",
              "scripts/model-caller.mjs",
              "scripts/evidence.mjs",
              "scripts/behaviors.mjs",
              "scripts/interfaces.mjs",
              "scripts/record.mjs",
              "scripts/pieces.mjs",
              "scripts/declines.mjs",
              "scripts/went-without.mjs"
            ],
            "references": [
              "references/the-as-built-record.md",
              "rules.md",
              "../../standards/architecture-standard.md"
            ]
          },
          "read-the-codebase": {
            "scripts": [
              "scripts/read-request.mjs",
              "scripts/run-config.mjs",
              "scripts/archive.mjs",
              "scripts/codebase.mjs",
              "scripts/facts.mjs",
              "scripts/surface.mjs",
              "scripts/js-source.mjs",
              "scripts/declarations.mjs",
              "scripts/flags.mjs",
              "scripts/carried.mjs"
            ]
          },
          "list-the-dependencies": {
            "scripts": [
              "scripts/sbom.mjs",
              "scripts/codebase.mjs"
            ]
          },
          "run-the-baseline": {
            "scripts": [
              "scripts/baseline.mjs"
            ]
          },
          "draft-from-the-code": {
            "scripts": [
              "scripts/draft.mjs",
              "scripts/model-caller.mjs",
              "scripts/codebase.mjs",
              "scripts/kinds.mjs"
            ],
            "references": [
              "references/the-as-built-record.md",
              "../../standards/architecture-standard.md"
            ]
          },
          "check-the-evidence": {
            "scripts": [
              "scripts/evidence.mjs",
              "scripts/codebase.mjs",
              "scripts/behaviors.mjs",
              "scripts/interfaces.mjs",
              "scripts/kinds.mjs",
              "scripts/surface.mjs",
              "scripts/js-source.mjs"
            ],
            "references": [
              "references/the-as-built-record.md"
            ]
          },
          "write-the-record": {
            "scripts": [
              "scripts/record.mjs",
              "scripts/pieces.mjs",
              "scripts/evidence.mjs",
              "scripts/codebase.mjs",
              "scripts/behaviors.mjs",
              "scripts/interfaces.mjs",
              "scripts/kinds.mjs",
              "scripts/facts.mjs",
              "scripts/surface.mjs",
              "scripts/js-source.mjs",
              "scripts/declarations.mjs",
              "scripts/flags.mjs",
              "scripts/declines.mjs",
              "scripts/went-without.mjs"
            ]
          }
        }
      }
    }
  }
}
