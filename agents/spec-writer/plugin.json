{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "spec-writer",
  "version": "0.12.1",
  "description": "Turns what you want an agent to do into its spec and then the agent's own files a builder takes, or your work into a process document, and asks what it could not settle.",
  "license": "Apache-2.0",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "write-a-spec",
    "read-what-was-asked",
    "draft-the-spec",
    "check-it-builds",
    "ask-what-is-missing",
    "write-a-process",
    "draft-the-process",
    "check-the-process"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "write-a-spec": {
            "scripts": [
              "scripts/asked.mjs",
              "scripts/draft.mjs",
              "scripts/spec.mjs",
              "scripts/seed.mjs",
              "scripts/spec-check.mjs",
              "scripts/spec-v1.mjs",
              "scripts/revise.mjs",
              "scripts/design.mjs",
              "scripts/structure.mjs",
              "scripts/declared.mjs",
              "scripts/json-in.mjs",
              "scripts/model-caller.mjs",
              "scripts/check-spec.mjs",
              "scripts/builds.mjs",
              "scripts/files.mjs",
              "scripts/ask.mjs",
              "scripts/went-without.mjs",
              "scripts/pieces.mjs",
              "scripts/agent-folder.mjs",
              "scripts/architecture-record.mjs",
              "scripts/can-use.mjs",
              "scripts/options.mjs",
              "scripts/job-seconds.mjs",
              "scripts/run-reply.mjs",
              "scripts/reaches.mjs",
              "scripts/given.mjs"
            ],
            "references": [
              "references/what-a-good-spec-carries.md",
              "references/a-spec-that-works.json",
              "rules.md",
              "../../standards/standing-asset-schemas.json",
              "../../standards/spec.schema.json",
              "references/plugin-manifest-schema.json"
            ]
          },
          "read-what-was-asked": {
            "scripts": [
              "scripts/asked.mjs",
              "scripts/agent-folder.mjs",
              "scripts/architecture-record.mjs"
            ]
          },
          "draft-the-spec": {
            "scripts": [
              "scripts/draft.mjs",
              "scripts/spec.mjs",
              "scripts/seed.mjs",
              "scripts/spec-check.mjs",
              "scripts/spec-v1.mjs",
              "scripts/revise.mjs",
              "scripts/design.mjs",
              "scripts/structure.mjs",
              "scripts/declared.mjs",
              "scripts/files.mjs",
              "scripts/json-in.mjs",
              "scripts/model-caller.mjs",
              "scripts/check-spec.mjs",
              "scripts/asked.mjs",
              "scripts/agent-folder.mjs",
              "scripts/architecture-record.mjs",
              "scripts/can-use.mjs",
              "scripts/options.mjs",
              "scripts/job-seconds.mjs",
              "scripts/run-reply.mjs",
              "scripts/reaches.mjs",
              "scripts/given.mjs"
            ],
            "references": [
              "references/what-a-good-spec-carries.md",
              "references/a-spec-that-works.json",
              "../../standards/standing-asset-schemas.json",
              "../../standards/spec.schema.json",
              "references/plugin-manifest-schema.json"
            ]
          },
          "check-it-builds": {
            "scripts": [
              "scripts/builds.mjs",
              "scripts/files.mjs",
              "scripts/job-seconds.mjs",
              "scripts/run-reply.mjs"
            ],
            "references": [
              "references/plugin-manifest-schema.json"
            ]
          },
          "ask-what-is-missing": {
            "scripts": [
              "scripts/ask.mjs",
              "scripts/asked.mjs",
              "scripts/went-without.mjs",
              "scripts/agent-folder.mjs",
              "scripts/reaches.mjs"
            ]
          },
          "write-a-process": {
            "scripts": [
              "scripts/process.mjs",
              "scripts/process-draft.mjs",
              "scripts/process-check.mjs",
              "scripts/model-caller.mjs",
              "scripts/went-without.mjs"
            ],
            "references": [
              "references/what-a-good-process-carries.md",
              "rules.md"
            ]
          },
          "draft-the-process": {
            "scripts": [
              "scripts/process-draft.mjs",
              "scripts/model-caller.mjs"
            ],
            "references": [
              "references/what-a-good-process-carries.md"
            ]
          },
          "check-the-process": {
            "scripts": [
              "scripts/process-check.mjs"
            ]
          }
        }
      }
    }
  }
}
