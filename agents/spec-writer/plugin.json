{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "spec-writer",
  "version": "0.6.0",
  "description": "Turns what somebody wants an agent to do into the agent's own files the builder will take (agent-descriptor.json, agent-runtime-requirements.json, plugin.json and a SKILL.md per skill), and says plainly what it could not settle without them.",
  "license": "Apache-2.0",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "built-agent",
    "draft",
    "write-a-spec",
    "read-what-was-asked",
    "draft-the-spec",
    "check-it-builds",
    "ask-what-is-missing"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "write-a-spec": {
            "scripts": [
              "scripts/asked.mjs",
              "scripts/draft.mjs",
              "scripts/model-caller.mjs",
              "scripts/check-spec.mjs",
              "scripts/builds.mjs",
              "scripts/files.mjs",
              "scripts/ask.mjs",
              "scripts/went-without.mjs",
              "scripts/pieces.mjs",
              "scripts/agent-folder.mjs",
              "scripts/architecture-record.mjs",
              "scripts/can-use.mjs",
              "scripts/options.mjs"
            ],
            "references": [
              "references/what-a-good-spec-carries.md",
              "references/a-spec-that-works.json",
              "rules.md",
              "../../standards/standing-asset-schemas.json",
              "references/plugin-manifest-schema.json"
            ]
          },
          "read-what-was-asked": {
            "scripts": [
              "scripts/asked.mjs",
              "scripts/agent-folder.mjs",
              "scripts/architecture-record.mjs"
            ]
          },
          "draft-the-spec": {
            "scripts": [
              "scripts/draft.mjs",
              "scripts/model-caller.mjs",
              "scripts/check-spec.mjs",
              "scripts/asked.mjs",
              "scripts/agent-folder.mjs",
              "scripts/architecture-record.mjs",
              "scripts/can-use.mjs",
              "scripts/options.mjs"
            ],
            "references": [
              "references/what-a-good-spec-carries.md",
              "references/a-spec-that-works.json",
              "../../standards/standing-asset-schemas.json"
            ]
          },
          "check-it-builds": {
            "scripts": [
              "scripts/builds.mjs",
              "scripts/files.mjs"
            ],
            "references": [
              "references/plugin-manifest-schema.json"
            ]
          },
          "ask-what-is-missing": {
            "scripts": [
              "scripts/ask.mjs",
              "scripts/asked.mjs",
              "scripts/went-without.mjs",
              "scripts/agent-folder.mjs"
            ]
          }
        }
      }
    }
  }
}
