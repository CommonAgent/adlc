{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "spec-writer",
  "version": "0.11.0",
  "description": "Turns what somebody wants an agent to do into the spec (spec-v1): the analysis of its functional requirements, each feature with requirements in the attributes of ISO/IEC/IEEE 29148 and acceptance scenarios in Gherkin, its interfaces, constraints, systems and settings, seeded by code from an as-built record when one comes; then makes the agent's own files the builder will take (agent-descriptor.json, agent-runtime-requirements.json, plugin.json and a SKILL.md per skill) from that spec. Or it writes work that passes between several agents and people as an Agent Processes 0.9.0 document, checked against the specification. Either way it says plainly what it could not settle without them.",
  "license": "Apache-2.0",
  "author": {
    "name": "Agent Builder"
  },
  "keywords": [
    "built-agent",
    "draft",
    "write-a-spec",
    "read-what-was-asked",
    "draft-the-spec",
    "check-it-builds",
    "ask-what-is-missing",
    "write-a-process",
    "draft-the-process",
    "check-the-process"
  ],
  "extensions": {
    "net.agentdoc.package": {
      "build": {
        "skills": {
          "write-a-spec": {
            "scripts": [
              "scripts/asked.mjs",
              "scripts/draft.mjs",
              "scripts/spec.mjs",
              "scripts/seed.mjs",
              "scripts/spec-check.mjs",
              "scripts/spec-v1.mjs",
              "scripts/revise.mjs",
              "scripts/design.mjs",
              "scripts/structure.mjs",
              "scripts/declared.mjs",
              "scripts/json-in.mjs",
              "scripts/model-caller.mjs",
              "scripts/check-spec.mjs",
              "scripts/builds.mjs",
              "scripts/files.mjs",
              "scripts/ask.mjs",
              "scripts/went-without.mjs",
              "scripts/pieces.mjs",
              "scripts/agent-folder.mjs",
              "scripts/architecture-record.mjs",
              "scripts/can-use.mjs",
              "scripts/options.mjs",
              "scripts/job-seconds.mjs",
              "scripts/run-reply.mjs",
              "scripts/reaches.mjs",
              "scripts/given.mjs"
            ],
            "references": [
              "references/what-a-good-spec-carries.md",
              "references/a-spec-that-works.json",
              "rules.md",
              "../../standards/standing-asset-schemas.json",
